{# This is the master layout file for the Salla theme #}
<!DOCTYPE html>
<html lang="{{ app.locale }}" dir="{{ app.dir }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ app.title }}</title>
    {# Add your CSS files here #}
    <link rel="stylesheet" href="{{ asset("css/app.css") }}">
</head>
<body>
    {% include "components/header/header.twig" %}

    <main>
        {% block content %}{% endblock %}
    </main>

    {% include "components/footer/footer.twig" %}

    {# Add your JS files here #}
    <script src="{{ asset("js/app.js") }}"></script>
</body>
<div style="background: yellow; color: black; padding: 20px; text-align: center; font-size: 30px; z-index: 9999; position: relative;">
    تم تفعيل الثيم بنجاح! 🚀
</div>

</html>
