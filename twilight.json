{
    "version": "1.0.0",
    "theme_name": "ثيم سلة المخصص",
    "description": "ثيم مخصص متكامل لمنصة سلة باستخدام إطار عمل Twilight",
    "repo_url": "https://github.com/noor-mandeel/salla-custom-theme",
    "author_email": "support@example.com",
    "support_url": "https://example.com",
    "settings": [
        {
            "type": "boolean",
            "label": "شريط علوي داكن",
            "id": "topnav_is_dark",
            "format": "switch",
            "value": false
        },
        {
            "type": "string",
            "id": "placeholder",
            "format": "hidden",
            "value": "images/img_placeholder.png"
        },
        {
            "type": "string",
            "label": "لون الزر الأساسي",
            "id": "primary_color",
            "format": "color",
            "value": "#007bff"
        }
    ],
    "features": [
        "component-featured-products",
        "component-fixed-products",
        "component-products-slider",
        "component-photos-slider",
        "component-parallax-background",
        "component-store-features",
        "filters",
        "component-square-photos",
        "component-fixed-banner"
    ],
    "components": [
        {
            "name": "hero-banner",
            "title": "بانر البطل",
            "icon": "sicon-image-carousel",
            "path": "home.hero-banner",
            "fields": [
                {
                    "id": "title",
                    "type": "string",
                    "label": "العنوان",
                    "required": true
                },
                {
                    "id": "subtitle",
                    "type": "string",
                    "label": "العنوان الفرعي",
                    "format": "textarea"
                },
                {
                    "id": "background_image",
                    "type": "string",
                    "label": "صورة الخلفية",
                    "format": "image"
                },
                {
                    "id": "button_text",
                    "type": "string",
                    "label": "نص الزر"
                },
                {
                    "id": "button_url",
                    "type": "string",
                    "label": "رابط الزر"
                }
            ]
        },
        {
            "name": "featured-section",
            "title": "قسم المنتجات المميزة",
            "icon": "sicon-products",
            "path": "home.featured-section",
            "fields": [
                {
                    "id": "title",
                    "type": "string",
                    "label": "العنوان",
                    "required": true
                },
                {
                    "id": "description",
                    "type": "string",
                    "label": "الوصف",
                    "format": "textarea"
                },
                {
                    "id": "view_all_url",
                    "type": "string",
                    "label": "رابط عرض الكل"
                }
            ]
        }
    ]
}