{% extends 'layouts/master.twig' %}

{% block content %}
    <div class="customer-profile">
        <h1>الملف الشخصي</h1>
        
        <div class="profile-container">
            <div class="profile-sidebar">
                <nav class="profile-menu">
                    <a href="#profile" class="menu-item active">المعلومات الشخصية</a>
                    <a href="#orders" class="menu-item">طلباتي</a>
                    <a href="#wishlist" class="menu-item">قائمة الرغبات</a>
                    <a href="#addresses" class="menu-item">عناويني</a>
                    <a href="#logout" class="menu-item">تسجيل الخروج</a>
                </nav>
            </div>
            
            <div class="profile-content">
                <div id="profile" class="profile-section">
                    <h2>المعلومات الشخصية</h2>
                    <form class="profile-form">
                        <div class="form-group">
                            <label>الاسم</label>
                            <input type="text" value="{{ customer.name }}">
                        </div>
                        <div class="form-group">
                            <label>البريد الإلكتروني</label>
                            <input type="email" value="{{ customer.email }}">
                        </div>
                        <div class="form-group">
                            <label>رقم الهاتف</label>
                            <input type="tel" value="{{ customer.phone }}">
                        </div>
                        <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
